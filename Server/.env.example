# Copy these names into Render > Environment (never put real keys on GitHub)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/schoolsystem
JWT_SECRET=put-a-long-random-text-here
FRONTEND_URL=https://your-app.vercel.app
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# SMS (paid, optional): arkesel or hubtel
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
SMS_SENDER_ID=SchoolApp

# WhatsApp (Meta WhatsApp Business Cloud API)
# WHATSAPP_TOKEN = permanent access token, WHATSAPP_PHONE_ID = "Phone number ID" (both from developers.facebook.com > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# To message parents first (reminders), WhatsApp needs an approved message template with ONE variable, for example:
#   School notice: {{1}} Thank you.
# Put the template's name here. Leave empty to send plain text (arrives only if the parent wrote to your number in the last 24 hours).
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en