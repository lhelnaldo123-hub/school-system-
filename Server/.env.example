# Copy these names into Render > Environment (never put real keys on GitHub)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/schoolsystem
# Password for YOUR private admin screen. Make it long and secret.
ADMIN_PASSWORD=change-this-to-a-strong-password
JWT_SECRET=put-a-long-random-text-here
FRONTEND_URL=https://your-app.vercel.app
# Paystack keys are NOT set here any more: each school owner pastes their own key in the app (School settings > Online payments).
# Optional: a separate secret used to lock those saved keys. If you leave it out, JWT_SECRET is used. Do not change it later.
ENC_KEY=put-another-long-random-text-here
# Optional: your server link, shown to owners as the Paystack webhook link (e.g. https://school-system-pe93.onrender.com)
API_URL=

# SMS (paid, optional): arkesel or hubtel
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
SMS_SENDER_ID=SchoolApp

# WhatsApp (Meta WhatsApp Business Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en