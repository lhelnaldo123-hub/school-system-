# Copy these names into Render > Environment (never put real keys on GitHub)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/schoolsystem
# Password for YOUR private admin screen. Make it long and secret.
ADMIN_PASSWORD=change-this-to-a-strong-password
JWT_SECRET=put-a-long-random-text-here
FRONTEND_URL=https://your-app.vercel.app
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# SMS (paid, optional): arkesel or hubtel
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
SMS_SENDER_ID=SchoolApp

# WhatsApp (Meta WhatsApp Business Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en